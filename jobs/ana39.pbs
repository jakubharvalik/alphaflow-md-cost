#!/bin/bash
#PBS -N l39_ana
#PBS -l select=1:ncpus=4:mem=16gb:scratch_local=10gb
#PBS -l walltime=4:00:00
#PBS -j oe
# Linie 39: dodatečný eval39 (LOO se shodným n, ATLAS 3 × 3,6 ns; prereg Z4, Z7a) pro hotové běhy runs/hyb39_*.
# b39.pbs (úlohy 25398494[], 25398495[]) eval39 nespustil, protože eval39.py nekopíroval do scratch. Jen čte, hotové přeskočí, lze spouštět opakovaně.
. /etc/profile >/dev/null 2>&1 || true
W=/storage/brno2/home/jakub_harvalik/md_pilot_work
L=$W/l39
A=$L/ana
P=$W/envs/omm13/bin/python
mkdir -p $L/logs $A
exec > >(tee -a $L/logs/ana39_${PBS_JOBID%%.*}.log) 2>&1
set -u
echo "$(date '+%F %T') start na $(hostname), PBS_JOBID $PBS_JOBID"
trap 'clean_scratch' TERM EXIT
export TMPDIR=$SCRATCHDIR OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
cd $SCRATCHDIR || exit 5
tar xzf $L/code39.tgz --warning=no-unknown-keyword || exit 6
cp $L/eval39.py . || { echo "chybí $L/eval39.py"; exit 6; }
n=0
for RUN in $L/runs/hyb39_*; do
  [ -s $RUN/hybrid_summary.json ] || continue
  b=$(basename $RUN); b=${b#hyb39_}
  N=$(echo $b | cut -d_ -f1-2); TAG=$(echo $b | cut -d_ -f3-); MODE=$(echo $TAG | cut -d_ -f1)
  [ -s $A/eval39_${N}_${TAG}.json ] && continue
  $P eval39.py --sys $L/sys/p2_$N --atlas $L/atlas/cache/$N --runs $MODE=$RUN --out $A/eval39_${N}_${TAG}.json < /dev/null > $A/eval39_${N}_${TAG}.txt 2>&1
  rc=$?; n=$((n + 1)); echo "$(date '+%T') $N $TAG eval39 kód $rc"
done
echo "$(date '+%F %T') konec, spočteno $n, eval39 JSON celkem $(ls $A/eval39_*.json 2>/dev/null | wc -l)"
